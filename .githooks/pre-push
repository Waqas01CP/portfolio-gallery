#!/bin/sh
# Gate E (ADR-0008): STATE.md moved, across the whole range being pushed.
# The logic is in tools/gates.py; this file only finds the project venv's
# interpreter and hands over, passing git's input through. A missing
# interpreter or gate script refuses the push (gate D). Activate once per
# clone:
#   git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel) || {
  echo "PUSH REFUSED: git could not report the repository root" >&2
  exit 1
}
py="$root/.venv/Scripts/python.exe"
[ -f "$py" ] || py="$root/.venv/bin/python"
if [ ! -f "$py" ]; then
  echo "PUSH REFUSED (gate D): missing tool: the project venv interpreter in .venv/." >&2
  echo "  Create the venv as docs/reference/commands.md describes." >&2
  exit 1
fi
if [ ! -f "$root/tools/gates.py" ]; then
  echo "PUSH REFUSED (gate D): missing tool: tools/gates.py" >&2
  exit 1
fi
exec "$py" "$root/tools/gates.py" pre-push "$@"
