{# The gallery: templates first, every design as a card one click from its
   live demo; then the showcase, contributors' own sites (ADR-0016). Every
   word is in this HTML and the page needs no script (scope floor line 3).
   A design's preview is a screenshot the deploy workflow takes of its demo
   with headless Chrome, never an image a contributor supplies (ADR-0006),
   so it cannot misrepresent its design. A showcase screenshot is supplied
   by its author (ADR-0016, D1) and shown as served copies made from it:
   whole, never cropped, at the card's full width in its own shape within
   the limits build.py sets, loaded only as it scrolls into view, and a
   click opens the larger copy: with scripts, in the page's own dialog,
   which static/gallery.js shows as a modal with a Close button (Brief 13,
   Addendum 1; ADR-0016, Changes, 2026-10-23); without them, as the page
   itself, the link it always is. Every picture has its size set, so the page
   does not shift as they load. The showcase's cards are packed as on
   Pinterest (ADR-0016, Changes, 2026-10-20): by the browser's own
   grid-lanes where it has them, else by static/gallery.js; with neither,
   they sit in rows. In every case they run in folder order, the order a
   keyboard and a screen reader meet them. #}
<!doctype html>
<!-- Generated by build.py from designs/, showcase/ and src/. Edit those, not this file. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="as-of" content="{{ as_of }}">
<meta name="generator" content="{{ project_name }}">
<title>{{ project_name }}: a gallery of portfolio designs</title>
<meta name="description" content="A free portfolio site template for GitHub Pages, and a gallery of designs for it, each contributed by pull request and checked for accessibility.">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:,">
<link rel="stylesheet" href="static/gallery.css">
<script src="static/gallery.js" defer></script>
</head>
<body>
<a class="skip" href="#designs">Skip to the designs</a>
<header class="g-head">
<p class="g-kicker">{{ project_name }}</p>
<h1>A portfolio site you can publish without installing anything</h1>
<p class="g-lede">The templates below each style the same page, shown here filled with sample content about invented people: {{ sample_name }}, or someone in the profession a template suits. Open one to see it working. To use one, make your own copy of the repository, write your content, and name the template in one setting. After them, the showcase: portfolio sites contributors built for themselves.</p>
<ul class="g-links">
<li><a href="{{ project_url }}#readme">How to use it</a></li>
<li><a href="{{ project_url }}/blob/main/docs/how-to/add-a-design.md">Add your own design</a></li>
<li><a href="{{ project_url }}/blob/main/docs/how-to/add-to-the-showcase.md">Add your site to the showcase</a></li>
<li><a href="{{ project_url }}">Source code</a></li>
</ul>
</header>
<main id="designs" class="g-main">
<section class="g-section" aria-labelledby="templates">
<h2 id="templates" class="g-sec">Templates</h2>
<p class="g-count">{{ designs|length }} design{{ "" if designs|length == 1 else "s" }} anyone can use, each selected by one line in content/config.json.</p>
<ul class="g-grid">
{% for d in designs %}
<li class="g-card">
<img class="g-shot" src="designs/{{ d.slug }}/{{ preview_file }}" width="{{ preview_size[0] }}" height="{{ preview_size[1] }}" alt="The first screen of the {{ d.name }} design" loading="{{ 'eager' if loop.index <= 2 else 'lazy' }}" decoding="async">
<div class="g-body">
<h3 class="g-name"><a href="designs/{{ d.slug }}/index.html">{{ d.name }}</a></h3>
<p class="g-by">By <a href="{{ d.author_url }}">{{ d.author }}</a></p>
<p class="g-sample">Shown with {{ d.sample.name }}, {{ d.sample.role }}</p>
<p class="g-desc">{{ d.description }}</p>
<p class="g-use">Setting: <code>"design": "{{ d.slug }}"</code></p>
{% if d.in_use %}
<p class="g-inuse">In use: <a href="{{ d.in_use }}" rel="ugc nofollow">{{ d.in_use_host }}</a><span class="vh">, {{ d.author }}'s own site built with {{ d.name }}</span></p>
{% endif %}
<p class="g-demo"><a class="g-btn" href="designs/{{ d.slug }}/index.html">Live demo<span class="vh">: {{ d.name }}</span></a></p>
</div>
</li>
{% endfor %}
</ul>
</section>
<section class="g-section" aria-labelledby="showcase">
<h2 id="showcase" class="g-sec">Showcase</h2>
{% if showcase %}
<p class="g-count">{{ showcase|length }} portfolio site{{ "" if showcase|length == 1 else "s" }} by contributors, each built its own way and shown with a screenshot its author supplied. These are not templates. <a href="{{ project_url }}/blob/main/docs/how-to/add-to-the-showcase.md">Add yours</a></p>
<ul class="g-pack" data-pack>
{% for e in showcase %}
<li class="g-card g-site">
<a class="g-frame" href="{{ e.full }}" data-full="{{ e.full_size[0] }}x{{ e.full_size[1] }}"><img class="g-full" src="{{ e.card }}" width="{{ e.card_size[0] }}" height="{{ e.card_size[1] }}" alt="{{ e.name }}'s portfolio site, a screenshot supplied by its author" loading="lazy" decoding="async"><span class="vh"> (full size)</span></a>
<div class="g-body">
<h3 class="g-name"><a href="{{ e.url }}" rel="ugc nofollow">{{ e.name }}</a></h3>
<p class="g-host">{{ e.host }}</p>
{% if e.description %}
<p class="g-desc">{{ e.description }}</p>
{% endif %}
</div>
</li>
{% endfor %}
</ul>
<dialog class="g-view" aria-labelledby="g-view-name" data-view>
<div class="g-view-bar"><p class="g-view-name" id="g-view-name" data-view-name></p><button type="button" class="g-view-close" aria-label="Close" data-view-close><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg></button></div>
</dialog>
{% else %}
<p class="g-count">No sites yet: portfolio sites by contributors, each built its own way, will be shown here. <a href="{{ project_url }}/blob/main/docs/how-to/add-to-the-showcase.md">Add yours</a></p>
{% endif %}
</section>
</main>
<footer class="g-foot">
<p>Every design is checked automatically before review: CSS and fonts only, nothing loaded from another site, and the same page for every design, tested for keyboard and screen reader use. Every showcase entry is checked for its format, and its site for answering over https without being parked; its screenshot is its author's. The maintainer reviews and merges each one. <a href="{{ project_url }}/blob/main/CONTRIBUTING.md">How contributions are reviewed</a></p>
<p>Built as of {{ as_of }}. MIT licensed.</p>
</footer>
</body>
</html>
