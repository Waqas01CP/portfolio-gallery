{# The gallery: one page showing every design as a card, each one click
   from its live demo. Every word is in this HTML and the page needs no
   script (scope floor line 3). The previews are screenshots the deploy
   workflow takes of each demo with headless Chrome, never images a
   contributor supplies (ADR-0006), so a preview cannot misrepresent its
   design. Each has its size set, so the page does not shift as they load. #}
<!doctype html>
<!-- Generated by build.py from designs/ and src/. Edit those, not this file. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="as-of" content="{{ as_of }}">
<meta name="generator" content="{{ project_name }}">
<title>{{ project_name }}: a gallery of portfolio designs</title>
<meta name="description" content="A free portfolio site template for GitHub Pages, and a gallery of designs for it, each contributed by pull request and checked for accessibility.">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:,">
<link rel="stylesheet" href="static/gallery.css">
</head>
<body>
<a class="skip" href="#designs">Skip to the designs</a>
<header class="g-head">
<p class="g-kicker">{{ project_name }}</p>
<h1>A portfolio site you can publish without installing anything</h1>
<p class="g-lede">Each design below styles the same page, shown here filled with sample content about an invented person, {{ sample_name }}. Open a design to see it working. To use one, make your own copy of the repository, write your content, and name the design in one setting.</p>
<ul class="g-links">
<li><a href="{{ project_url }}#readme">How to use it</a></li>
<li><a href="{{ project_url }}/blob/main/docs/how-to/add-a-design.md">Add your own design</a></li>
<li><a href="{{ project_url }}">Source code</a></li>
</ul>
</header>
<main id="designs" class="g-main">
<h2 class="g-count">{{ designs|length }} design{{ "" if designs|length == 1 else "s" }}</h2>
<ul class="g-grid">
{% for d in designs %}
<li class="g-card">
<img class="g-shot" src="designs/{{ d.slug }}/{{ preview_file }}" width="{{ preview_size[0] }}" height="{{ preview_size[1] }}" alt="The first screen of the {{ d.name }} design" loading="{{ 'eager' if loop.index <= 2 else 'lazy' }}" decoding="async">
<div class="g-body">
<h3 class="g-name"><a href="designs/{{ d.slug }}/index.html">{{ d.name }}</a></h3>
<p class="g-by">By <a href="{{ d.author_url }}">{{ d.author }}</a></p>
<p class="g-desc">{{ d.description }}</p>
<p class="g-use">Setting: <code>"design": "{{ d.slug }}"</code></p>
<p class="g-demo"><a class="g-btn" href="designs/{{ d.slug }}/index.html">Live demo<span class="vh">: {{ d.name }}</span></a></p>
</div>
</li>
{% endfor %}
</ul>
</main>
<footer class="g-foot">
<p>Every design is checked automatically before review: CSS and fonts only, nothing loaded from another site, and the same page for every design, tested for keyboard and screen reader use. The maintainer reviews and merges each one. <a href="{{ project_url }}/blob/main/CONTRIBUTING.md">How designs are reviewed</a></p>
<p>Built as of {{ as_of }}. MIT licensed.</p>
</footer>
</body>
</html>
