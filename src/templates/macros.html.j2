{# Shared pieces. Imported by each template that needs them. #}

{# Dates as parts from build.date_phrase, each date in its own <time>. #}
{% macro when(w) -%}
<time datetime="{{ w.start }}">{{ w.start_text }}</time>
{%- if w.end_text %} to {% if w.end %}<time datetime="{{ w.end }}">{{ w.end_text }}</time>{% else %}{{ w.end_text }}{% endif %}{% endif %}
{%- endmacro %}

{# A space a screen reader keeps. Where pieces of one line are laid out as
   separate boxes (flex or grid items, or blocks), the space between them
   in the markup is never rendered, and a screen reader such as NVDA reads
   them as one word: a first name run into a surname, or "Dec 20255-Day".
   This space is hidden from sight but rendered, so it reaches the
   accessibility tree (.vh in base.css keeps it). Found by a real NVDA
   run on the site this engine was copied from (docs/reference/provenance.md). #}
{% macro sp() %}<span class="vh"> </span>{% endmacro %}

{# A section heading: the number and the faded word are decoration, hidden
   from assistive technology; the h2 is the name. #}
{% macro head(s) -%}
<header class="sec-head">
<span class="fade-word" aria-hidden="true" data-fade-word>{{ s.label }}</span>
<div class="sec-title"><span class="sec-n" aria-hidden="true">{{ s.n }}</span><h2 id="h-{{ s.id }}">{{ s.label }}</h2></div>
</header>
{%- endmacro %}

{# Icons, drawn here and decorative only. No brand mark is drawn or
   shipped: a link names its destination in words (ADR-0006). #}
{% macro icon(name, size=13) -%}
{% if name == "out" %}<svg class="i" aria-hidden="true" width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
{%- elif name == "mail" %}<svg class="i" aria-hidden="true" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M4 7l8 6 8-6"/></svg>
{%- elif name == "case" %}<svg class="i" aria-hidden="true" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M3 12.5h18"/></svg>
{%- elif name == "cap" %}<svg class="i" aria-hidden="true" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg>
{%- elif name == "link" %}<svg class="i" aria-hidden="true" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
{%- elif name == "moon" %}<svg class="i" aria-hidden="true" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
{%- elif name == "menu" %}<svg class="i i-menu" aria-hidden="true" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path class="i-open" d="M4 8h16M4 16h16"/><path class="i-close" d="M6 6l12 12M18 6L6 18"/></svg>
{%- elif name == "pause" %}<svg class="i" aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="currentColor"><path class="i-pause" d="M2 1h2v8H2zM6 1h2v8H6z"/><path class="i-play" d="M2 1l7 4-7 4z"/></svg>
{%- endif %}
{%- endmacro %}
