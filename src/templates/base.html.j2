{# The document shell. The page is complete without scripts: every word is
   here, every section reads in order, and every disclosure that needs a
   script starts open. static/site.js only reveals, filters and animates
   (scope floor line 3). Every URL is relative to this page (ADR-0007), and
   the policy below refuses anything from another origin (ADR-0006).

   The HTML is the same in every design; a design is a stylesheet
   (ADR-0006). Its stylesheet loads first and the engine's base.css after
   it, so on equal terms the engine's accessibility rules win. #}
<!doctype html>
<!-- Generated by build.py from content/ and src/. Edit those, not this file. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# The month `present` resolved to; two builds as of the same month and
   from the same source are byte-identical. #}
<meta name="as-of" content="{{ as_of }}">
<meta name="generator" content="{{ project_name }}">
<title>{{ site.name }}</title>
<meta name="description" content="{{ site.headline|join(' | ') }}">
<meta name="color-scheme" content="light dark">
{# An empty icon, so the browser does not ask the server for one. #}
<link rel="icon" href="data:,">
{# The design's own fonts that set text on the opening screen, preloaded
   so they arrive with the stylesheet rather than after first paint, and
   the text does not reflow when they swap in. #}
{% for font in design.preload %}
<link rel="preload" href="{{ design_href }}{{ font }}" as="font" type="font/woff2" crossorigin>
{% endfor %}
<link rel="stylesheet" href="{{ design_href }}design.css">
<link rel="stylesheet" href="{{ root }}static/base.css">
<link rel="stylesheet" href="{{ root }}static/layout.css">
<script src="{{ root }}static/site.js" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
{% include "nav.html.j2" %}
<main id="main">
{% include "intro.html.j2" %}
<div class="page">
{% if section.projects %}{% include "projects.html.j2" %}{% endif %}
{% if section.timeline %}{% include "timeline.html.j2" %}{% endif %}
{% if section.work %}{% include "work.html.j2" %}{% endif %}
{% if section.education %}{% include "education.html.j2" %}{% endif %}
{% if section.certifications %}{% include "certifications.html.j2" %}{% endif %}
{% if section.skills %}{% include "skills.html.j2" %}{% endif %}
{% include "contact.html.j2" %}
</div>
</main>
{% include "footer.html.j2" %}
</body>
</html>
