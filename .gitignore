# Briefs are working space and can carry private paths; never committed.
# Only the folder's README is tracked.
briefs/*
!briefs/README.md

# The architecture chat's ledger, once there is one, is never committed.
CHAT_STATE.md

# Local build environment and Python artefacts. The venv is recreated from
# requirements.txt, which is committed.
.venv/
__pycache__/
*.pyc

# Build output. The workflows build the site and the gallery; nothing
# built is committed (ADR-0004).
_site*/
_gallery/
.build-*/

# axe-core, fetched for the checks on your own computer
# (docs/reference/commands.md); the checks workflow fetches its own.
.cache/
