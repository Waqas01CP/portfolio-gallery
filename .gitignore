# Briefs are working space and can carry private paths; the whole folder,
# its README with it, is never committed (CLAUDE.md, Briefs).
briefs/

# The architecture chat's ledger, once there is one, is never committed.
CHAT_STATE.md

# The architecture chat's lane of CAPABILITIES.md: never committed, since
# every copy of the template inherits what is (the owner's decision of
# 2026-10-18). Gate A refuses it at any path.
CAPABILITIES-PRIVATE.md

# Local build environment and Python artefacts. The venv is recreated from
# requirements.txt, which is committed.
.venv/
__pycache__/
*.pyc

# Build output. The workflows build the site and the gallery; nothing
# built is committed (ADR-0004).
_site*/
_gallery/
_samples/
.build-*/

# axe-core, fetched for the checks on your own computer
# (docs/reference/commands.md); the checks workflow fetches its own.
.cache/
